# Optional: show badge in app shell (DEV / PAPER / LIVE)
# VITE_DESK_ENV=LIVE

# Lock UI to one book (no Mock/Dhan toggle). mock = paper desk; broker = Dhan desk (label "Live").
# Leave unset for local dev with both rails.
# VITE_DESK_PROFILE=mock
# VITE_DESK_PROFILE=broker

# When VITE_DESK_PROFILE=broker, PnL chip label (default Live)
# VITE_BROKER_BOOK_LABEL=Live

# Default broker for Orders/PnL API (?broker=). Must match RMS TOE_TARGETS / desk.
# VITE_DEFAULT_BROKER=mock
# VITE_DEFAULT_BROKER=dhan_sandbox

# Dev server bind (default 127.0.0.1; default port 5173 avoids Windows reserved ranges on 3005).
# VITE_DEV_SERVER_HOST=0.0.0.0
# VITE_DEV_SERVER_PORT=5173

# Dev server proxy targets (npm run dev). Defaults match localhost.
# Override on mock vs broker servers — see .env.mock-desk.example / .env.broker-desk.example
# DESK_PROXY_BACKEND=http://127.0.0.1:8010
# DESK_PROXY_RMS=http://127.0.0.1:8001
# DESK_PROXY_TOE_MOCK=http://127.0.0.1:8002
# DESK_PROXY_TOE_DHAN=http://127.0.0.1:8003

# --- Desk login (backend root .env, not this Vite file) ---
# DESK_AUTH_ENABLED=true
# DESK_AUTH_ADMIN_USERNAME=admin
# DESK_AUTH_PASSWORD_HASH=  bcrypt hash from scripts/hash_desk_password.py
# DESK_SETUP_PASSWORD_HASH= different bcrypt hash for Setup & Risk
# DESK_JWT_SECRET=          long random signing key
# DESK_AUTH_COOKIE_SECURE=true
# INTERNAL_API_KEY=         same value on RMS so /api/pnl still works
# If you terminate TLS at nginx, set X-Forwarded-Proto (see dashboard/nginx.conf).