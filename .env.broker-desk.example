# Dev-only: copy to .env next to vite.config.js for `npm run dev` on the BROKER server.
# Point each line at this machine’s service ports (or hostnames in production tunnel).

DESK_PROXY_BACKEND=http://127.0.0.1:8010
DESK_PROXY_RMS=http://127.0.0.1:8001
DESK_PROXY_TOE_MOCK=http://127.0.0.1:8002
DESK_PROXY_TOE_DHAN=http://127.0.0.1:8003

# VITE_DESK_ENV=LIVE

# Lock Orders/PnL to broker book; UI label "Live" (API broker id stays dhan_sandbox)
VITE_DESK_PROFILE=broker
VITE_DEFAULT_BROKER=dhan_sandbox
VITE_BROKER_BOOK_LABEL=Live
