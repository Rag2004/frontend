# Dev-only: copy to .env next to vite.config.js for `npm run dev` on the MOCK server.
# Proxies default to localhost; change hosts if Backend/RMS/TOE run on another machine.

DESK_PROXY_BACKEND=http://127.0.0.1:8010
DESK_PROXY_RMS=http://127.0.0.1:8001
DESK_PROXY_TOE_MOCK=http://127.0.0.1:8002
# Mock desk may omit toe_dhan; proxy target can stay default or point to a stub.
DESK_PROXY_TOE_DHAN=http://127.0.0.1:8003

# Optional shell badge
# VITE_DESK_ENV=PAPER

# Lock Orders/PnL to mock only (no Dhan toggle)
VITE_DESK_PROFILE=mock
VITE_DEFAULT_BROKER=mock
